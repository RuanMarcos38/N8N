        "jsCode": "const e=$input.first().json.body||{};\nif(!['requested','queued','sent','delivered','read','replied','failed','call_started','call_answered','call_ended','qualified','opt_out'].includes(e.kind))throw Error('Status inválido');\nfor(const k of ['owner_id','workspace_id','event_id','lead_id'])if(typeof e[k]!=='string'||!e[k])throw Error('Campo ausente: '+k);\nif(!['email','whatsapp','voice'].includes(e.channel))throw Error('Canal inválido');\nreturn [{json:e}];"

        "query": "SELECT m.id::text AS id, m.content, m.direction, m.provider, m.provider_message_id, m.status, m.occurred_at,\n v.channel, c.id::text AS contact_id, c.name, c.email, c.phone,\n EXISTS(SELECT 1 FROM r2r_comercial.suppressions x WHERE x.identifier IN(c.email,c.phone)) AS suppressed\n FROM r2r_comercial.messages m\n JOIN r2r_comercial.conversations v ON v.id=m.conversation_id\n JOIN r2r_comercial.contacts c ON c.id=v.contact_id\n WHERE m.id > $1::bigint AND m.occurred_at > now()-interval '7 days'\n ORDER BY m.id ASC LIMIT 50;",
